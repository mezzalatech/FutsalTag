{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARF FutsalTag",
  "version": "0.2.0",
  "identifier": "com.futsaltag.pro",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ARF FutsalTag - Futsal Video Analyser, Telestrator & Tactical Board",
        "width": 1366,
        "height": 840,
        "minWidth": 768,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/models/*",
      "resources/bin/*",
      "resources/whisper/*",
      "resources/bin-macos/*",
      "resources/whisper-macos/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "futsal"
        ],
        "name": "ARF FutsalTag Project",
        "description": "Proyek Analisis Video ARF FutsalTag",
        "mimeType": "application/x-futsaltag-project"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MDZGNDBDNjE3NEQ3QjEKUldTeDEzUmhEUFFHTkUwbGt4VitjdmtmUkQvRU5URzRBSzQrTW9uL3J2WW5NaWZkQ0l0UEdMQ0gK",
      "endpoints": [
        "https://github.com/mezzalatech/FutsalTag/releases/latest/download/latest.json"
      ]
    }
  }
}