{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FutsalTag Pro",
  "version": "0.1.0",
  "identifier": "com.futsaltag.pro",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FutsalTag Pro - Futsal Video Analyser, Telestrator & Tactical Board",
        "width": 1366,
        "height": 840,
        "minWidth": 768,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/models/*", "resources/whisper/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
